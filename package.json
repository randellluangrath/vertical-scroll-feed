{
  "name": "goodwatch",
  "version": "0.1.0",
  "private": true,
  "description": "GoodWatch — React Native tvOS app with an AWS Amplify (Gen 2) backend.",
  "scripts": {
    "sandbox": "ampx sandbox --outputs-out-dir apps/tv",
    "sandbox:once": "ampx sandbox --once --outputs-out-dir apps/tv",
    "seed": "ampx sandbox seed",
    "deploy": "ampx pipeline-deploy --branch main --app-id $AMPLIFY_APP_ID",
    "outputs": "ampx generate outputs --out-dir apps/tv",
    "tv": "cd apps/tv && npm start",
    "tv:ios": "cd apps/tv && npm run ios"
  },
  "dependencies": {
    "aws-amplify": "^6.18.0"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.23.0",
    "@aws-amplify/backend-cli": "^1.8.3",
    "@aws-amplify/seed": "^1.1.3",
    "@types/node": "^20",
    "aws-cdk-lib": "^2.244.0",
    "constructs": "^10.6.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  }
}
