{
  "expo": {
    "name": "GoodWatch TV",
    "slug": "goodwatch-tv",
    "version": "0.1.0",
    "orientation": "landscape",
    "platforms": ["ios", "android"],
    "ios": {
      "bundleIdentifier": "com.goodwatch.tv"
    },
    "plugins": [
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": true
        }
      ]
    ],
    "android": {
      "package": "com.goodwatch.tv"
    }
  }
}
